{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Instance": {
    "Name": "hsconcessions"
  },
  "Seed": {
    "Profile": "generic"
  },
  "Storage": {
    "DataPath": "./data",
    "ImagesPath": "./data/images",
    "LogsPath": "./logs",
    "BackupsPath": "./backups"
  },
  "Features": {
    "Events": false,
    "OptionPricing": false,
    "StandScopedRoles": false
  },
  "Auth": {
    "SystemAdmins": [],
    "CookieDays": 14,
    "Providers": {
      "Google": {
        "Enabled": true,
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "Enabled": true,
        "ClientId": "",
        "ClientSecret": ""
      }
    },
    "DevLogin": {
      "Enabled": false
    }
  }
}
