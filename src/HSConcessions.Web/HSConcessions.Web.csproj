<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Map" Version="2.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <!-- Seed profiles ship with the app so a fresh deploy can initialize data/. -->
  <ItemGroup>
    <!-- Only the profile folders (samples/<profile>/...), not loose files such as source documents in samples/. -->
    <Content Include="..\..\samples\*\**\*" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="data\**;logs\**;backups\**" />
    <None Remove="data\**;logs\**;backups\**" />
    <Content Update="appsettings.Example.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
