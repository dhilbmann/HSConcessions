{
  "_comment": "Copy to appsettings.Production.json (or set the same keys as environment variables, e.g. Auth__Providers__Google__ClientSecret). Never commit real secrets.",
  "Instance": {
    "Name": "myschool"
  },
  "Seed": {
    "Profile": "generic"
  },
  "Storage": {
    "DataPath": "/var/lib/myschool/data",
    "ImagesPath": "/var/lib/myschool/data/images",
    "LogsPath": "/var/lib/myschool/logs",
    "BackupsPath": "/var/lib/myschool/backups"
  },
  "Features": {
    "Events": false,
    "OptionPricing": false,
    "StandScopedRoles": false
  },
  "Auth": {
    "SystemAdmins": [ "you@example.com" ],
    "CookieDays": 14,
    "Providers": {
      "Google": {
        "Enabled": true,
        "ClientId": "set-via-env-Auth__Providers__Google__ClientId",
        "ClientSecret": "set-via-env-Auth__Providers__Google__ClientSecret"
      },
      "Microsoft": {
        "Enabled": true,
        "ClientId": "set-via-env-Auth__Providers__Microsoft__ClientId",
        "ClientSecret": "set-via-env-Auth__Providers__Microsoft__ClientSecret"
      }
    }
  }
}
