{
  "Instance": {
    "Name": "demo"
  },
  "Demo": {
    "Enabled": true,
    "ResetIntervalMinutes": 1440
  },
  "Hosting": {
    "TrustForwardedHeaders": true
  },
  "Auth": {
    "SystemAdmins": [ "admin@demo.test" ],
