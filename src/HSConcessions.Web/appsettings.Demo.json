    "DevLogin": {
      "Enabled": true,
      "Personas": [
        { "Label": "System Admin", "Email": "admin@demo.test", "Roles": [] },
        { "Label": "Administrator", "Email": "administrator@demo.test", "Roles": [ "Administrator" ] },
        { "Label": "Pricing", "Email": "pricing@demo.test", "Roles": [ "Pricing" ] },
        { "Label": "Manager", "Email": "manager@demo.test", "Roles": [ "Manager" ] },
        { "Label": "Pricing + Manager", "Email": "pricing-manager@demo.test", "Roles": [ "Pricing", "Manager" ] }
      ]
    }
  }
}
