# /etc/hsconcessions/<instance>.env  — chmod 600, owned by root. Never commit real values.
ASPNETCORE_URLS=http://127.0.0.1:5080

# First run only: which samples/ profile seeds an empty data folder (generic or wildcatsnacks).
Seed__Profile=generic

# System Admin email(s) — always have every permission and can't be locked out.
Auth__SystemAdmins__0=you@example.com
# Auth__SystemAdmins__1=someone-else@example.com

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
Auth__Providers__Google__Enabled=true
Auth__Providers__Google__ClientId=
Auth__Providers__Google__ClientSecret=

# Microsoft OAuth (https://entra.microsoft.com → App registrations), "common" endpoint
Auth__Providers__Microsoft__Enabled=true
Auth__Providers__Microsoft__ClientId=
Auth__Providers__Microsoft__ClientSecret=

# Optional feature flags
# Features__Events=false
# Features__OptionPricing=false
# Features__StandScopedRoles=false
